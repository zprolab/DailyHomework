// Windows application icon and version resource. ASCII only: the resource
// compiler does not reliably agree with source files in other code pages.
// The icon itself is resolved through the include directories CMake adds for
// this target (see apps/qt/CMakeLists.txt).

#include <windows.h>

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DaHoWork"
            VALUE "FileDescription", "DaHoWork daily homework presenter"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "DaHoWork"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "DaHoWork.exe"
            VALUE "ProductName", "DaHoWork"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
